{
  "name": "presentkim/visibleautopickup",
  "description": "Automatically picks up items and xp orbs before others pick them up, for axolotl-pm/PocketMine-MP",
  "type": "project",
  "license": "LGPL-3.0-or-later",
  "require": {
    "php": "^8.4",
    "presentkim/remove-plugin-data-folder": "^2.0"
  },
  "require-dev": {
    "axolotl-pm/pocketmine-mp": "^5.51",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "kim\\present\\visibleautopickup\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "kim\\present\\visibleautopickup\\tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
